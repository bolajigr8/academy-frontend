# Copy to .env.local and fill in. Never commit .env.local.

# Base URL of the backend API, ending in /api/v1
# e.g. http://127.0.0.1:8000/api/v1 when the backend runs on your machine
NEXT_PUBLIC_API_URL=

# The data toggle:
#   api  (default) every area whose endpoints exist uses the backend only
#   mock           the whole app runs on the prototype's demo data
# With NEXT_PUBLIC_API_URL empty the app always runs in mock mode.
NEXT_PUBLIC_DATA_MODE=api

# Blog (Golafly's Sanity blog, the same project as Matchday; public read, no token).
# These are the defaults: set them only to use another project or dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=sngce5kj
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Which posts this site shows: the post's "Section" in Sanity ("academy"), or "all"
NEXT_PUBLIC_BLOG_SECTION=academy
